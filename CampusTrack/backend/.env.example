# ======================================================================
# CampusTrack - Environment Configuration
# ======================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Leave blank to run in embedded ultra-fast test mode, or fill with your MySQL credentials
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=campus_track

# JWT Authentication Secret
JWT_SECRET=campustrack_super_secure_jwt_secret_2026_key

# Google Maps Platform API Keys (Optional)
# If provided, enables Google Routes API for road distance and traffic duration
GOOGLE_MAPS_SERVER_KEY=your_google_maps_backend_key
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_frontend_key
